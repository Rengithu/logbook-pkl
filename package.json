{
  "name": "pkl-report-app",
  "version": "1.0.0",
  "description": "Aplikasi Laporan PKL - buat, kelola, dan unduh laporan harian & mingguan PKL dalam format Word (.docx) dan PDF",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "cd client && npm run build",
    "build:start": "npm run build && npm start"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.11",
    "docx": "^9.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "image-size": "^1.1.1",
    "lowdb": "^1.0.0",
    "multer": "^2.0.0",
    "pdfkit": "^0.15.0",
    "sharp": "^0.35.3",
    "uuid": "^9.0.1"
  }
}

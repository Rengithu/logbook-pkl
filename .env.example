# Salin file ini menjadi ".env" lalu isi API key kamu.
# Dapatkan API key gratis di https://aistudio.google.com/app/apikey

GEMINI_API_KEY=isi_api_key_gemini_kamu_di_sini
# Opsional: Jika Anda ingin mengganti versi model AI-nya, secara default menggunakan gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash

# Base URL API Gemini (default: https://generativelanguage.googleapis.com/v1beta/models)
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Maksimal ukuran file upload kegiatan (dalam bytes, default: 8388608 = 8MB)
MAX_UPLOAD_SIZE=8388608

# Maksimal jumlah file upload kegiatan (default: 10 file)
MAX_UPLOAD_FILES=10

# Maksimal ukuran file upload untuk lampiran tugas (dalam bytes, default: 10485760 = 10MB)
MAX_TASK_UPLOAD_SIZE=10485760

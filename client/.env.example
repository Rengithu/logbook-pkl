# URL target proxy untuk komunikasi ke backend API (default: http://localhost:3000)
VITE_API_URL=http://localhost:3000

# Endpoint OpenRouter API (default: https://openrouter.ai/api/v1/chat/completions)
VITE_OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# Model AI default yang digunakan saat chat via OpenRouter/Ollama (default: qwen2.5-coder:7b)
VITE_DEFAULT_AI_MODEL=qwen2.5-coder:7b
